# Required for the LLM orchestrator
# Select backend: claude | gemini | ollama
LLM_BACKEND=claude

# Anthropic Claude (required if LLM_BACKEND=claude)
ANTHROPIC_API_KEY=your_api_key_here
# CLAUDE_MODEL=claude-opus-4-5

# Google Gemini (required if LLM_BACKEND=gemini)
# GEMINI_API_KEY=your_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Ollama local model (required if LLM_BACKEND=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Python Style Analysis service URL
# STYLE_ANALYSIS_URL=http://localhost:8001

# Premiere Pro bridge configuration
# Set to the Premiere Pro version number for automatic bridge mode selection.
# Example: 22.0 for Premiere 2022, 25.2 for Premiere 2025
# PREMIERE_VERSION=25.2

# Override bridge mode regardless of version detection
# PREMIERE_BRIDGE_MODE=extendscript

# Port for CEP/ExtendScript TCP bridge (must match panel.html setting)
# CEP_PORT=3201

# WebSocket URL for UXP panel bridge (Premiere 25.2+ only)
# UXP_WS_URL=ws://localhost:3200

# MCP server launch command (used by the orchestrator CLI)
# MCP_SERVER_CMD=node
# MCP_SERVER_ARGS=../../mcp-server/dist/index.js
